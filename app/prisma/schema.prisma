generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gastos    Gasto[]
}

model Gasto {
  id          Int      @id @default(autoincrement())
  descripcion String
  monto       Float
  fecha       DateTime
  estado      EstadoGasto @default(PENDIENTE)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ConfiguracionCorreo {
  id                Int      @id @default(autoincrement())
  servidorSmtp      String
  puerto            Int      @default(587)
  usuario           String
  password          String
  emailRemitente    String
  frecuenciaHoras   Int      @default(24)
  activo            Boolean  @default(false)
  ultimoEnvio       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum EstadoGasto {
  PENDIENTE
  PAGADO
}
